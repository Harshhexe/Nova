{
  "name": "nova-new-tab",
  "private": true,
  "version": "1.0.0-preview.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "package:extension": "npm run build && node -e \"require('node:fs').rmSync('nova-extension.zip',{force:true})\" && cd dist && zip -r ../nova-extension.zip .",
    "start": "node server/index.mjs",
    "build:browser": "node desktop/native/build-trackpad.mjs && npm run build && vite build --config desktop/vite.config.ts",
    "browser": "npm run build:browser && electron desktop/main.mjs",
    "package:mac": "npm run build:browser && node scripts/package-macos.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ghostery/adblocker-electron": "^2.20.3",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.4.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
