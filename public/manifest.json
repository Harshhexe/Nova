{
  "manifest_version": 3,
  "name": "NOVA \u2014 Your browser. Your universe.",
  "version": "1.0.0",
  "description": "A peaceful, personal new tab with beautiful shortcuts and focus tools.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage"
  ],
  "icons": {
    "128": "icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "host_permissions": [
    "https://suggestqueries.google.com/*"
  ]
}
